{
	"compilerOptions": {
		"target": "ES2024",
		"module": "commonjs",
		"outDir": "./dist",
		"rootDir": "./",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowImportingTsExtensions": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
}
